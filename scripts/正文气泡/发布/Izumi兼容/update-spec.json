        "replaceString": "<pre hidden><style>\n/* 引入可爱字体 */\n@import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&display=swap');\n\n/* 最外层容器 */\n.konata-thinking-wrapper {\n    display: block;\n    margin: 10px 0;\n    font-family: 'M PLUS Rounded 1c', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;\n}\n\n/* details 主容器 */\n.konata-thinking-details {\n    background-color: #FFF9FA;\n    border: 1.5px solid #FBCFE8;\n    border-radius: 22px;\n    overflow: hidden;\n    box-shadow: 0 8px 25px -8px rgba(244, 114, 182, 0.3);\n    transition: box-shadow 0.3s ease, transform 0.3s ease;\n    position: relative;\n}\n\n.konata-thinking-details:hover {\n    transform: translateY(-2px);\n}\n\n.konata-thinking-details[open] {\n    box-shadow: 0 12px 35px -5px rgba(244, 114, 182, 0.4);\n}\n\n/* 气泡背景容器 */\n.konata-particles-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    overflow: hidden;\n    z-index: 1;\n    opacity: 0;\n    transition: opacity 0.3s ease;\n}\n\n.konata-thinking-details[open] .konata-particles-bg {\n    opacity: 1;\n}\n\n/* 气泡样式 */\n.konata-bubble {\n    position: absolute;\n    bottom: -150px;\n    border-radius: 50%;\n    opacity: 0;\n    will-change: transform, opacity;\n    animation: konataRise 15s linear infinite;\n    filter: blur(1px);\n}\n\n@keyframes konataRise {\n    0% { transform: translate3d(0, 0, 0) scale(0.7); opacity: 0; }\n    10% { opacity: 0.7; }\n    50% { transform: translate3d(var(--sway-x, 20px), -50vh, 0) scale(1.1); opacity: 0.9; }\n    90% { opacity: 0.4; }\n    100% { transform: translate3d(var(--sway-x-end, -20px), -110vh, 0) scale(0.6); opacity: 0; }\n}\n\n/* summary 标题栏 */\n.konata-thinking-summary {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 16px 22px;\n    background-color: #FEEFF4;\n    border-bottom: 1.5px solid #FBCFE8;\n    cursor: pointer;\n    user-select: none;\n    list-style: none;\n    position: relative;\n    z-index: 2;\n    transition: background-color 0.3s ease;\n    color: #584964;\n    font-weight: 700;\n    font-size: 15px;\n}\n\n.konata-thinking-summary::-webkit-details-marker,\n.konata-thinking-summary::marker {\n    display: none;\n}\n\n.konata-thinking-summary:hover {\n    background-color: #FDE7F0;\n}\n\n/* 标题文字部分 */\n.konata-title-content {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n/* 跳动的小桃心 */\n.konata-heart {\n    display: inline-block;\n    font-size: 16px;\n    animation: konataHeartbeat 1.5s ease-in-out infinite;\n    color: #F472B6;\n}\n\n@keyframes konataHeartbeat {\n    0%, 100% { transform: scale(1); }\n    10% { transform: scale(1.2); }\n    20% { transform: scale(1); }\n    30% { transform: scale(1.15); }\n    40% { transform: scale(1); }\n}\n\n/* 展开/收起图标 */\n.konata-thinking-summary::after {\n    content: '⌄';\n    font-size: 24px;\n    font-weight: 300;\n    color: #F472B6;\n    transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55), color 0.3s ease;\n    line-height: 1;\n}\n\n.konata-thinking-summary:hover::after {\n    color: #F9A8D4;\n}\n\n.konata-thinking-details[open] .konata-thinking-summary::after {\n    transform: rotate(180deg) scale(1.1);\n    color: #F9A8D4;\n}\n\n/* 内容区域 - 完整的 Markdown 样式支持 */\n.konata-thinking-content {\n    position: relative;\n    z-index: 2;\n    padding: 14px 18px;\n    max-height: 350px;\n    overflow-y: auto;\n    overflow-x: hidden;\n    color: #6D5B79;\n    font-size: 13.5px;\n    line-height: 1.7;\n    white-space: pre-wrap;\n    word-wrap: break-word;\n    animation: konataSlideIn 0.35s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n@keyframes konataSlideIn {\n    from {\n        opacity: 0;\n        transform: translateY(-12px) scale(0.95);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0) scale(1);\n    }\n}\n\n/* Markdown 段落 */\n.konata-thinking-content p {\n    margin: 8px 0;\n}\n.konata-thinking-content p:first-child {\n    margin-top: 0;\n}\n.konata-thinking-content p:last-child {\n    margin-bottom: 0;\n}\n\n/* 粗体 */\n.konata-thinking-content strong {\n    font-weight: 700;\n    color: #d946a6;\n    text-shadow: 0 0 8px rgba(217, 70, 166, 0.2);\n}\n\n/* 斜体 */\n.konata-thinking-content em {\n    font-style: italic;\n    opacity: 0.92;\n    color: #ba68c8;\n}\n\n/* 行内代码 */\n.konata-thinking-content code {\n    background: rgba(255, 182, 193, 0.15);\n    color: #ec4899;\n    padding: 2px 7px;\n    border-radius: 5px;\n    font-size: 12.5px;\n    font-family: 'Consolas', 'Monaco', monospace;\n    border: 1px solid rgba(255, 182, 193, 0.25);\n}\n\n/* 代码块 */\n.konata-thinking-content pre {\n    background: linear-gradient(135deg, rgba(255, 182, 193, 0.08), rgba(186, 104, 200, 0.08));\n    border-left: 3px solid rgba(255, 105, 180, 0.4);\n    padding: 10px 12px;\n    border-radius: 8px;\n    overflow-x: auto;\n    margin: 10px 0;\n    box-shadow: inset 0 1px 3px rgba(255, 105, 180, 0.1);\n}\n\n.konata-thinking-content pre code {\n    background: none;\n    padding: 0;\n    font-size: 12px;\n    border: none;\n}\n\n/* 链接 */\n.konata-thinking-content a {\n    color: #ff69b4;\n    text-decoration: none;\n    border-bottom: 2px dotted rgba(255, 105, 180, 0.4);\n    transition: all 0.2s;\n    font-weight: 600;\n}\n\n.konata-thinking-content a:hover {\n    color: #ff1493;\n    border-bottom-color: #ff1493;\n    text-shadow: 0 0 8px rgba(255, 20, 147, 0.3);\n}\n\n/* 列表 */\n.konata-thinking-content ul,\n.konata-thinking-content ol {\n    margin: 8px 0;\n    padding-left: 22px;\n}\n\n.konata-thinking-content li {\n    margin: 4px 0;\n    position: relative;\n}\n\n.konata-thinking-content li::marker {\n    color: #ff69b4;\n}\n\n/* 引用块 */\n.konata-thinking-content blockquote {\n    border-left: 3px solid rgba(255, 105, 180, 0.35);\n    background: rgba(255, 182, 193, 0.05);\n    padding: 8px 12px;\n    margin: 10px 0;\n    border-radius: 0 8px 8px 0;\n    font-style: italic;\n    color: #9c4a9e;\n}\n\n/* 标题 */\n.konata-thinking-content h1,\n.konata-thinking-content h2,\n.konata-thinking-content h3,\n.konata-thinking-content h4,\n.konata-thinking-content h5,\n.konata-thinking-content h6 {\n    color: #ff69b4;\n    font-weight: 700;\n    margin: 12px 0 8px 0;\n    border-bottom: 1px dashed rgba(255, 105, 180, 0.2);\n    padding-bottom: 5px;\n}\n\n.konata-thinking-content h1 { font-size: 18px; }\n.konata-thinking-content h2 { font-size: 16px; }\n.konata-thinking-content h3 { font-size: 15px; }\n.konata-thinking-content h4 { font-size: 14px; }\n\n/* 水平线 */\n.konata-thinking-content hr {\n    border: none;\n    border-top: 2px dashed rgba(255, 105, 180, 0.3);\n    margin: 15px 0;\n}\n\n/* 滚动条美化 */\n.konata-thinking-content::-webkit-scrollbar {\n    width: 6px;\n}\n\n.konata-thinking-content::-webkit-scrollbar-track {\n    background: linear-gradient(180deg, rgba(255, 182, 193, 0.15), rgba(186, 104, 200, 0.15));\n    border-radius: 3px;\n}\n\n.konata-thinking-content::-webkit-scrollbar-thumb {\n    background: linear-gradient(180deg, #ffb3d9, #ba68c8);\n    border-radius: 3px;\n    transition: background 0.2s;\n    box-shadow: inset 0 0 3px rgba(255, 255, 255, 0.5);\n}\n\n.konata-thinking-content::-webkit-scrollbar-thumb:hover {\n    background: linear-gradient(180deg, #ff69b4, #d946a6);\n}\n\n/* 移动端适配 */\n@media (max-width: 480px) {\n    .konata-thinking-details {\n        border-radius: 18px;\n    }\n    .konata-thinking-summary {\n        padding: 14px 18px;\n        font-size: 14px;\n    }\n    .konata-thinking-content {\n        max-height: 300px;\n        padding: 12px 15px;\n        font-size: 13px;\n    }\n}\n\n/* 减弱动画 */\n@media (prefers-reduced-motion: reduce) {\n    * {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.01ms !important;\n    }\n    .konata-bubble,\n    .konata-heart {\n        animation: none !important;\n    }\n}\n</style></pre>\n\n<div class=\"konata-thinking-wrapper\">\n    <details class=\"konata-thinking-details\">\n        <div class=\"konata-particles-bg\"></div>\n        <summary class=\"konata-thinking-summary\">\n            <span class=\"konata-title-content\">\n                <span class=\"konata-heart\">💕</span>\n                <span>小此在思考✨</span>\n            </span>\n        </summary>\n        <div class=\"konata-thinking-content\">$1</div>\n    </details>\n</div>\n\n<script>\n(function() {\n    var CONFIG = {\n        bubbleInterval: 400,\n        bubbleSizeMin: 20,\n        bubbleSizeMax: 90,\n        bubbleDurationMin: 10,\n        bubbleDurationMax: 18,\n        bubbleColors: [\n            'rgba(244, 114, 182, 0.7)',\n            'rgba(249, 168, 212, 0.6)',\n            'rgba(251, 207, 232, 0.8)'\n        ]\n    };\n\n    var bubbleIntervalId = null;\n\n    function createBubble(particlesBg) {\n        var bubble = document.createElement('div');\n        bubble.className = 'konata-bubble';\n\n        var size = Math.random() * (CONFIG.bubbleSizeMax - CONFIG.bubbleSizeMin) + CONFIG.bubbleSizeMin;\n        var duration = Math.random() * (CONFIG.bubbleDurationMax - CONFIG.bubbleDurationMin) + CONFIG.bubbleDurationMin;\n        var color = CONFIG.bubbleColors[Math.floor(Math.random() * CONFIG.bubbleColors.length)];\n        var swayX = (Math.random() - 0.5) * 120;\n        var swayXEnd = (Math.random() - 0.5) * 120;\n\n        bubble.style.width = size + 'px';\n        bubble.style.height = size + 'px';\n        bubble.style.left = (Math.random() * 100) + '%';\n        bubble.style.background = 'radial-gradient(circle at 35% 35%, ' + color + ', transparent 65%)';\n        bubble.style.animationDuration = duration + 's';\n        bubble.style.animationDelay = (Math.random() * 2) + 's';\n        bubble.style.setProperty('--sway-x', swayX + 'px');\n        bubble.style.setProperty('--sway-x-end', swayXEnd + 'px');\n\n        particlesBg.appendChild(bubble);\n\n        setTimeout(function() {\n            if (bubble.parentNode) {\n                bubble.parentNode.removeChild(bubble);\n            }\n        }, (duration + 3) * 1000);\n    }\n\n    function init() {\n        var details = document.querySelector('.konata-thinking-details');\n        var particlesBg = document.querySelector('.konata-particles-bg');\n        \n        if (!details || !particlesBg) {\n            setTimeout(init, 200);\n            return;\n        }\n\n        if (details.hasAttribute('data-konata-init')) return;\n        details.setAttribute('data-konata-init', 'true');\n\n        details.addEventListener('toggle', function() {\n            if (details.open) {\n                if (!bubbleIntervalId) {\n                    bubbleIntervalId = setInterval(function() {\n                        createBubble(particlesBg);\n                    }, CONFIG.bubbleInterval);\n                }\n            } else {\n                if (bubbleIntervalId) {\n                    clearInterval(bubbleIntervalId);\n                    bubbleIntervalId = null;\n                }\n            }\n        });\n    }\n\n    setTimeout(init, 100);\n    setTimeout(init, 500);\n    setTimeout(init, 1000);\n})();\n</script>",
